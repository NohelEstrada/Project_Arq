{
  "name": "Memory_Usage_Critical",
  "stream_type": "metrics",
  "stream_name": "node_memory_MemAvailable_bytes",
  "is_real_time": "true",
  "query_condition": {
    "type": "custom",
    "conditions": {
      "groupId": "memory-critical-group",
      "label": "and",
      "items": [
        {
          "column": "instance",
          "operator": "=",
          "value": "pharmacy-server",
          "ignore_case": false,
          "id": "condition-instance"
        }
      ]
    },
    "sql": null,
    "promql": null,
    "promql_condition": null,
    "aggregation": {
      "group_by": ["instance"],
      "function": "avg",
      "having": {
        "column": "value",
        "operator": "<=",
        "value": 1073741824,
        "ignore_case": false
      }
    },
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 2,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 30,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "destinations": [
    "Slack Alertas"
  ],
  "context_attributes": [],
  "row_template": "",
  "description": "Alerta cuando la memoria disponible es menor a 1GB (crítico)",
  "enabled": true
}
