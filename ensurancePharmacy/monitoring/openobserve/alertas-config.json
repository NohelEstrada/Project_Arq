    {
      "name": "Jenkins_Build_Duration_Long",
      "stream_type": "metrics",
      "stream_name": "prometheus",
      "query_type": "promql",
      "query": "default_jenkins_builds_last_build_duration_milliseconds / 60000",
      "condition": {
        "column": "value",
        "operator": ">",
        "value": 10
      },
      "duration": 1,
      "frequency": 1,
      "time_between_alerts": 60,
      "destination": [
