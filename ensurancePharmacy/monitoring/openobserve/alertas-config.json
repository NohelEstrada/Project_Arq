          "template": {
            "text": "🟡 *ADVERTENCIA: CPU*\n\n*Alerta:* {alert_name}\n*Severidad:* Warning\n*Valor actual:* {alert_agg_value}%\n*Umbral:* {alert_threshold}%\n*Inicio:* {alert_trigger_time_str}"
