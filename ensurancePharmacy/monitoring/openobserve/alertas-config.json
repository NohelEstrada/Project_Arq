    {
      "name": "Jenkins_Error_Rate_High",
      "stream_type": "metrics",
      "stream_name": "prometheus",
      "query_type": "promql",
      "query": "(default_jenkins_builds_failed_build_count_total / default_jenkins_builds_total_build_count_total) * 100",
      "condition": {
        "column": "value",
